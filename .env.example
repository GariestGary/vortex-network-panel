VORTEX_MODE=mock
VORTEX_SESSION_SECRET=replace-with-a-long-random-secret
VORTEX_NETCTL_SOCKET=/run/vortex-netctl/vortex-netctl.sock
# Production only: output of `getent group vortex-netctl | cut -d: -f3`
VORTEX_NETCTL_GID=
# Production only: public HTTPS origin for Remote Profile imports
VORTEX_PUBLIC_SUBSCRIPTION_URL=https://sub.jetstream.su
